{
  "name": "Survey",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "student_user_id": {
      "type": "string"
    },
    "block_name": {
      "type": "string"
    },
    "room_number": {
      "type": "string"
    },
    "semester": {
      "type": "string"
    },
    "room_satisfaction": {
      "type": "number"
    },
    "facility_satisfaction": {
      "type": "number"
    },
    "internet_satisfaction": {
      "type": "number"
    },
    "staff_satisfaction": {
      "type": "number"
    },
    "security_satisfaction": {
      "type": "number"
    },
    "overall_satisfaction": {
      "type": "number"
    },
    "comments": {
      "type": "string"
    },
    "suggestions": {
      "type": "string"
    },
    "checkout_id": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "student_name",
    "overall_satisfaction"
  ],
  "rls": {
    "create": {
      "data.student_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "principal"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "data.student_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "data.student_user_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "principal"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}