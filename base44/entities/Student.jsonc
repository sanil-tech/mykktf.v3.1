{
  "name": "Student",
  "type": "object",
  "properties": {
    "profile_completed": {
      "type": "boolean",
      "default": false,
      "description": "Indicates whether student has completed onboarding profile"
    },
    "student_id": {
      "type": "string",
      "description": "University student ID"
    },
    "full_name": {
      "type": "string"
    },
    "ic_passport": {
      "type": "string",
      "description": "IC or Passport number"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female"
      ]
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "faculty": {
      "type": "string"
    },
    "programme": {
      "type": "string"
    },
    "year_of_study": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "block_name": {
      "type": "string",
      "description": "Assigned residential block"
    },
    "room_number": {
      "type": "string",
      "description": "Assigned room number"
    },
    "parent_name": {
      "type": "string"
    },
    "parent_phone": {
      "type": "string"
    },
    "emergency_contact": {
      "type": "string"
    },
    "vehicle_reg": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "enum": [
        "Registered",
        "ProfileIncomplete",
        "ProfileCompleted",
        "PendingVerification",
        "Approved",
        "CheckedIn",
        "ActiveResident",
        "CheckedOut",
        "Inactive"
      ],
      "default": "registered"
    },
    "user_id": {
      "type": "string",
      "description": "Linked User account ID"
    }
  },
  "required": [
    "student_id",
    "full_name",
    "gender",
    "faculty",
    "phone",
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    }
  }
}