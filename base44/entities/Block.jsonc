{
  "name": "Block",
  "type": "object",
  "properties": {
    "block_name": {
      "type": "string"
    },
    "gender_restriction": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Mixed"
      ]
    },
    "total_floors": {
      "type": "number"
    }
  },
  "required": [
    "block_name",
    "gender_restriction",
    "total_floors"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    }
  }
}