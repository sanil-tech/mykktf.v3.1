{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "action_type": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "resource_type": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "affected_user_id": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "session_context": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "before_after_metadata": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "user_name",
    "action",
    "module"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": {
          "$in": ["super_admin", "principal"]
        }
      }
    },
    "update": false,
    "delete": false
  }
}