{
  "name": "CheckOut",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "ID Pelajar"
    },
    "student_name": {
      "type": "string",
      "title": "Nama Pelajar"
    },
    "room_id": {
      "type": "string",
      "title": "ID Bilik"
    },
    "room_number": {
      "type": "string",
      "title": "Nombor Bilik"
    },
    "block_name": {
      "type": "string",
      "title": "Nama Blok"
    },
    "check_out_date": {
      "type": "string",
      "format": "date",
      "title": "Tarikh Daftar Keluar"
    },
    "check_out_time": {
      "type": "string",
      "title": "Masa Daftar Keluar"
    },
    "room_condition": {
      "type": "string",
      "enum": [
        "Good",
        "Fair",
        "Damaged"
      ],
      "title": "Keadaan Bilik"
    },
    "damage_assessment": {
      "type": "string",
      "title": "Penilaian Kerosakan"
    },
    "refund_amount": {
      "type": "number",
      "default": 0,
      "title": "Jumlah Bayaran Balik"
    },
    "approved_by": {
      "type": "string",
      "title": "Diluluskan Oleh"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "approved",
        "rejected"
      ],
      "default": "pending_verification",
      "title": "Status Permohonan"
    },
    "notes": {
      "type": "string",
      "title": "Nota & Metadata Permohonan"
    },
    "semester": {
      "type": "string",
      "title": "Semester"
    },
    "student_matric": {
      "type": "string",
      "title": "No Matrik Pelajar"
    }
  },
  "required": [
    "student_id",
    "student_name",
    "room_id",
    "room_number",
    "check_out_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "student"
          }
        },
        {
          "user_condition": {
            "role": "principal"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "student"
          }
        },
        {
          "user_condition": {
            "role": "principal"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "principal"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "principal"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    }
  }
}