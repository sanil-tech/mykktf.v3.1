{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "General Notice",
        "Emergency Notice",
        "Event Notice",
        "Student Activities",
        "Sports",
        "Community Programs",
        "Volunteer Programs",
        "Club Activities",
        "General Student Notices"
      ]
    },
    "attachment": {
      "type": "string",
      "format": "uri"
    },
    "link": {
      "type": "string"
    },
    "publish_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "published_by": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "General",
        "Important",
        "Critical"
      ],
      "default": "General"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "published",
        "pending_approval",
        "rejected"
      ],
      "default": "published",
      "description": "Approval state. JAKMAS-submitted official notices are 'pending_approval' until an admin approves; non-official JAKMAS content and admin/warden posts are 'published' directly."
    },
    "approval_feedback": {
      "type": "string",
      "description": "Admin feedback when an official notice submission is rejected."
    }
  },
  "required": [
    "title",
    "content",
    "type",
    "publish_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "jakmas"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}