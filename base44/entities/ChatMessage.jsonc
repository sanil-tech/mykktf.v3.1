{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "room",
        "block",
        "community",
        "public",
        "direct_message"
      ]
    },
    "channel_key": {
      "type": "string",
      "description": "room_number+block for room chat, block_name for block, 'kktf' for community, 'dm_userId1_userId2' for DMs"
    },
    "sender_user_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "format": "uri"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "reported": {
      "type": "boolean",
      "default": false
    },
    "report_reason": {
      "type": "string"
    }
  },
  "required": [
    "channel",
    "channel_key",
    "sender_user_id",
    "sender_name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "data.sender_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    }
  }
}