{
  "name": "FacilityBooking",
  "type": "object",
  "properties": {
    "facility": {
      "type": "string",
      "enum": [
        "Study Room",
        "Multipurpose Hall",
        "Tennis Court",
        "Basketball Court",
        "Meeting Room"
      ]
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "booking_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected",
        "Cancelled"
      ],
      "default": "Pending"
    },
    "approved_by": {
      "type": "string"
    }
  },
  "required": [
    "facility",
    "student_id",
    "student_name",
    "booking_date",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    }
  }
}