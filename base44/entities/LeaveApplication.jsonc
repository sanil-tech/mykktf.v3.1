{
  "name": "LeaveApplication",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Student matric number"
    },
    "student_name": {
      "type": "string"
    },
    "block_name": {
      "type": "string",
      "description": "Student's block at time of submission"
    },
    "room_number": {
      "type": "string",
      "description": "Student's room at time of submission"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "Weekend",
        "Semester Break",
        "Emergency",
        "Medical",
        "Other"
      ]
    },
    "destination": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "departure_time": {
      "type": "string"
    },
    "return_date": {
      "type": "string",
      "format": "date"
    },
    "return_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending"
    },
    "approved_by": {
      "type": "string"
    },
    "remarks": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "student_name",
    "leave_type",
    "destination",
    "reason",
    "departure_date",
    "return_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "warden"
              }
            },
            {
              "data.block_name": {
                "$in": "{{user.data.assigned_block_names}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "warden"
              }
            },
            {
              "data.block_name": {
                "$in": "{{user.data.assigned_block_names}}"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    }
  }
}