{
  "name": "LeaveApplication",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Student matric number"
    },
    "student_name": {
      "type": "string"
    },
    "block_name": {
      "type": "string",
      "description": "Student's block at time of submission"
    },
    "room_number": {
      "type": "string",
      "description": "Student's room at time of submission"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "Weekend",
        "Semester Break",
        "Emergency",
        "Medical",
        "Other"
      ]
    },
    "destination": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "departure_time": {
      "type": "string"
    },
    "return_date": {
      "type": "string",
      "format": "date"
    },
    "return_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected",
        "Returned"
      ],
      "default": "Pending"
    },
    "approved_by": {
      "type": "string"
    },
    "remarks": {
      "type": "string"
    },
    "returned_at": {
      "type": "string",
      "format": "date-time"
    },
    "returned_date": {
      "type": "string"
    },
    "returned_time": {
      "type": "string"
    },
    "return_method": {
      "type": "string",
      "enum": [
        "QR_BLOCK_SCAN",
        "QR_GUARDHOUSE",
        "MANUAL_WARDEN",
        "SELF_CHECKIN"
      ]
    },
    "return_status": {
      "type": "string",
      "enum": [
        "On-Time",
        "Late",
        "Early"
      ]
    },
    "return_scanned_block": {
      "type": "string"
    },
    "geofence_verified": {
      "type": "boolean",
      "default": false
    },
    "return_distance_meters": {
      "type": "number"
    },
    "return_lat": {
      "type": "number"
    },
    "return_lng": {
      "type": "number"
    }
  },
  "required": [
    "student_id",
    "student_name",
    "leave_type",
    "destination",
    "reason",
    "departure_date",
    "return_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    }
  }
}