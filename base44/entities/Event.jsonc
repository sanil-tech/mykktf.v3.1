{
  "name": "Event",
  "type": "object",
  "properties": {
    "event_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "event_time": {
      "type": "string"
    },
    "organizer": {
      "type": "string"
    },
    "organizer_user_id": {
      "type": "string"
    },
    "registration_limit": {
      "type": "number"
    },
    "current_registrations": {
      "type": "number",
      "default": 0
    },
    "poster_url": {
      "type": "string",
      "format": "uri"
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "Open",
        "Closed",
        "Full"
      ],
      "default": "Open"
    },
    "status": {
      "type": "string",
      "enum": [
        "Upcoming",
        "Ongoing",
        "Completed",
        "Cancelled"
      ],
      "default": "Upcoming"
    },
    "modality": {
      "type": "string",
      "enum": [
        "Bersemuka",
        "Dalam Talian",
        "Hibrid"
      ],
      "default": "Bersemuka"
    },
    "platform": {
      "type": "string"
    },
    "meeting_link": {
      "type": "string"
    },
    "felo_approval_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending"
    },
    "felo_coordinator_id": {
      "type": "string"
    },
    "felo_coordinator_name": {
      "type": "string"
    },
    "merit_points": {
      "type": "number",
      "default": 10
    },
    "rejection_reason": {
      "type": "string"
    },
    "creator_role": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    }
  },
  "required": [
    "event_name",
    "venue",
    "event_date",
    "organizer"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "jakmas"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "data.organizer_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "data.organizer_user_id": "{{user.id}}"
        }
      ]
    }
  }
}