{
  "name": "EventRegistration",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "student_user_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Registered",
        "Cancelled",
        "Attended"
      ],
      "default": "Registered"
    }
  },
  "required": [
    "event_id",
    "event_name",
    "student_user_id",
    "student_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.student_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "jakmas"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "jakmas"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.student_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}