{
  "name": "Alumni",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "University student ID (matric number)"
    },
    "full_name": {
      "type": "string"
    },
    "ic_passport": {
      "type": "string",
      "description": "IC or Passport number"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female"
      ]
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "faculty": {
      "type": "string"
    },
    "programme": {
      "type": "string"
    },
    "year_of_study": {
      "type": "number"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "block_name": {
      "type": "string",
      "description": "Last assigned residential block"
    },
    "room_number": {
      "type": "string",
      "description": "Last assigned room number"
    },
    "check_in_date": {
      "type": "string",
      "format": "date"
    },
    "check_out_date": {
      "type": "string",
      "format": "date"
    },
    "room_condition": {
      "type": "string"
    },
    "semester": {
      "type": "string",
      "description": "Academic session at time of archive"
    },
    "user_id": {
      "type": "string",
      "description": "Linked User account ID"
    },
    "archived_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "student_id",
    "full_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    }
  }
}