{
  "name": "AnnouncementRead",
  "type": "object",
  "properties": {
    "announcement_id": {
      "type": "string"
    },
    "student_user_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "acknowledged": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "announcement_id",
    "student_user_id"
  ],
  "rls": {
    "create": {
      "data.student_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.student_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    },
    "update": {
      "data.student_user_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}