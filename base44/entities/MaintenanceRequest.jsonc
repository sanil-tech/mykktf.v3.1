{
  "name": "MaintenanceRequest",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "room_number": {
      "type": "string"
    },
    "block_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Electrical",
        "Plumbing",
        "Furniture",
        "Internet",
        "Cleaning",
        "Others"
      ]
    },
    "description": {
      "type": "string"
    },
    "photo": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "enum": [
        "Submitted",
        "Assigned",
        "In Progress",
        "Completed"
      ],
      "default": "Submitted"
    },
    "assigned_to": {
      "type": "string"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "remarks": {
      "type": "string"
    },
    "completion_remarks": {
      "type": "string"
    },
    "completion_photo": {
      "type": "string",
      "format": "uri"
    },
    "verified_by": {
      "type": "string"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "My Room",
        "Common Area",
        "Other Facility"
      ],
      "default": "My Room"
    },
    "specific_location": {
      "type": "string"
    },
    "myserv_ticket_no": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "student_name",
    "category",
    "description"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    }
  }
}