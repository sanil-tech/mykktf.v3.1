{
  "name": "WardenBlock",
  "type": "object",
  "properties": {
    "warden_user_id": {
      "type": "string",
      "description": "User ID of the warden"
    },
    "warden_name": {
      "type": "string"
    },
    "warden_email": {
      "type": "string"
    },
    "block_id": {
      "type": "string"
    },
    "block_name": {
      "type": "string"
    }
  },
  "required": [
    "warden_user_id",
    "warden_name",
    "block_id",
    "block_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "data.warden_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    }
  }
}