{
  "name": "Complaint",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Suggestion",
        "Welfare Concern",
        "General Feedback",
        "Complaint"
      ],
      "default": "Suggestion"
    },
    "category": {
      "type": "string",
      "enum": [
        "Student Welfare & Safety",
        "Roommate & Quiet Hours",
        "Cafeteria & Food Services",
        "Staff & Counter Service",
        "College Activities & JAKMAS",
        "General Idea & Suggestion",
        "Others"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "block_name": {
      "type": "string"
    },
    "room_number": {
      "type": "string"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "student_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Submitted",
        "Under Review",
        "Resolved",
        "Closed"
      ],
      "default": "Submitted"
    },
    "admin_response": {
      "type": "string"
    },
    "warden_response": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "attachment": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "type",
    "category",
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        },
        {
          "user_condition": {
            "role": "warden"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "college_admin"
          }
        }
      ]
    }
  }
}